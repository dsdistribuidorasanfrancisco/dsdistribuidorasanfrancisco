{
  "functions": {
    "api/home.js": { "includeFiles": "template.html" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/", "destination": "/api/home" },
    { "source": "/:slug([a-z0-9][a-z0-9-]*)", "destination": "/api/og?slug=:slug" },
    { "source": "/(.*)", "destination": "/api/home" }
  ]
}
